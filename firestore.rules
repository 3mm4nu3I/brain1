rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-All Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Schema Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    function isValidSavedFormula(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'normalizedHappiness', 'allostaticLoad']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'normalizedHappiness', 'allostaticLoad', 'archetypeTitle', 'variablesSnapshot', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.title is string && data.title.size() <= 140 &&
        data.normalizedHappiness is number &&
        data.allostaticLoad is number &&
        (!('archetypeTitle' in data) || (data.archetypeTitle is string && data.archetypeTitle.size() <= 100)) &&
        (!('variablesSnapshot' in data) || (data.variablesSnapshot is string && data.variablesSnapshot.size() <= 30000));
    }

    function isValidJournalNote(data) {
      return data.keys().hasAll(['id', 'userId', 'noteText']) &&
        data.keys().hasOnly(['id', 'userId', 'noteText', 'happinessScore', 'archetype', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.noteText is string && data.noteText.size() <= 4000 &&
        (!('happinessScore' in data) || data.happinessScore is number) &&
        (!('archetype' in data) || (data.archetype is string && data.archetype.size() <= 100));
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || resource.data.uid == request.auth.uid);
      allow list: if false; // Blanket user listing forbidden for PII security
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);
    }

    // Saved Formulas Collection
    match /savedFormulas/{formulaId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(formulaId) && isValidSavedFormula(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(formulaId) && existing().userId == request.auth.uid && incoming().userId == existing().userId && isValidSavedFormula(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Cranial Journal Notes Collection
    match /journalNotes/{noteId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(noteId) && isValidJournalNote(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(noteId) && existing().userId == request.auth.uid && incoming().userId == existing().userId && isValidJournalNote(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
